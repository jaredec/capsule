# One cheap LLM key is all the collector needs (the first one set is used).
# Gemini Flash-Lite has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=

# Optional overrides: LLM_PROVIDER=gemini|xai|openai, or any OpenAI-compatible endpoint.
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY=
